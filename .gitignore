# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
.firebase/

# env files (can opt-in for committing if needed)
.env*
# ...but the documented template must be committed, or nobody can configure the
# app. `.env*` above would otherwise swallow it.
!.env.local.example

# Script output — screenshots and exported MP4s from the QA and e2e runs
/visual-qa
/e2e
/e2e-reopen
/e2e-upload

# ffmpeg.wasm core, copied from node_modules by scripts/copy-ffmpeg-core.mjs
/public/ffmpeg

# A stray empty git repo that appeared at the project root — one generated
# .gitattributes, no remote, no history worth keeping. Excluded rather than
# deleted. Left staged it would become a broken submodule: GitHub would show an
# unclickable grey folder and a clone would come down empty. Delete the
# directory and this line together once you have confirmed it is not wanted.
/BOLO/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
